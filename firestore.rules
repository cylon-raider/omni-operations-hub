rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Practice owners — always approved, bootstrapped as payroll admin on
    // first login, and exempt from call deletion restrictions. Keep in sync
    // with OWNER_EMAILS in src/utils/payrollConstants.js, functions/access.js
    // and storage.rules.
    function isOwnerEmail() {
      return request.auth != null
        && request.auth.token.email in ['luckyj5521@gmail.com', 'cmarkel@gmail.com'];
    }

    function myProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Signing in is not enough: anyone on the internet can create a Firebase
    // Auth account. Every read and write of practice data also requires the
    // account to be approved — `approved: true` on users/{uid}, which only a
    // payroll admin can set (Financials → Team → App Access). Owners are
    // always approved. Keep in sync with requireApprovedUser in
    // functions/access.js, which applies the same check to the HTTP functions.
    function isApproved() {
      return request.auth != null
        && (isOwnerEmail()
            || (exists(myProfilePath())
                && get(myProfilePath()).data.get('approved', false) == true));
    }

    // Payroll admins can manage payroll and approve accounts. Revoking an
    // account's approval also takes away its admin rights.
    function isPayrollAdmin() {
      return isApproved()
        && exists(myProfilePath())
        && get(myProfilePath()).data.get('payrollRole', null) == 'admin';
    }

    // User profiles.
    // - A payroll admin can write anything on anyone's doc (approving
    //   accounts, promoting/demoting `payrollRole`).
    // - Anyone can write their OWN profile, except:
    //     * the approval fields — never self-set, so nobody can approve
    //       themselves;
    //     * `payrollRole` — only ever self-set once, to bootstrap it, and only
    //       to the value computed here (admin for owner emails, viewer
    //       otherwise). Mirrors usePayrollRole.js, but re-validated
    //       server-side so a non-owner can never grant themselves admin;
    //     * `email` — must be the account's real sign-in email, so an admin
    //       reviewing a pending account sees who it actually is.
    // - A pending (unapproved) user can read their own doc, so the app can
    //   show them the "waiting for approval" screen, but nobody else's.
    match /users/{userId} {
      function isSelf() {
        return request.auth != null && request.auth.uid == userId;
      }

      // request.resource is null on delete and resource is null on create;
      // every helper below is only reached with request.resource != null.
      function changedKeys() {
        return resource == null
          ? request.resource.data.keys()
          : request.resource.data.diff(resource.data).affectedKeys();
      }

      function selfApprovalUntouched() {
        return !changedKeys().hasAny(['approved', 'approvedBy', 'approvedAt']);
      }

      function selfPayrollRoleOk() {
        let before = resource == null ? null : resource.data.get('payrollRole', null);
        let after = request.resource.data.get('payrollRole', null);
        return after == before
          || (before == null && after == (isOwnerEmail() ? 'admin' : 'viewer'));
      }

      function selfEmailOk() {
        return !('email' in changedKeys())
          || (request.auth.token.email is string
              && request.resource.data.email is string
              && request.resource.data.email.lower() == request.auth.token.email.lower());
      }

      allow read: if isSelf() || isApproved();

      allow write: if isPayrollAdmin()
        || (isSelf()
            && request.resource != null
            && selfApprovalUntouched()
            && selfPayrollRoleOk()
            && selfEmailOk());
    }

    // Payroll: staff directory, schedule, and daily collections logs.
    // Read requires an approved account; writes require payroll admin.
    // `rate` is intentionally NOT stored here — see payroll_staffRates below —
    // so a non-admin reading the directory can never see anyone's pay rate.
    match /payroll_staff/{staffId} {
      allow read: if isApproved();
      // request.resource is null on delete — guard before reading .data, or
      // this rule errors (and therefore denies) every delete.
      allow write: if isPayrollAdmin()
        && (request.resource == null || !('rate' in request.resource.data));
    }
    match /payroll_schedule/{dayId} {
      allow read: if isApproved();
      allow write: if isPayrollAdmin();
    }
    match /payroll_dailyLogs/{dayId} {
      allow read: if isApproved();
      allow write: if isPayrollAdmin();
    }

    // Payroll pay rates, split out of payroll_staff so they can be locked
    // down per-person: a payroll admin can read/write any rate; a staff
    // member can only read the single rate doc whose linked payroll_staff
    // email matches their own login email (never anyone else's).
    match /payroll_staffRates/{staffId} {
      allow read: if isPayrollAdmin()
        || (isApproved()
            && request.auth.token.email != null
            && get(/databases/$(database)/documents/payroll_staff/$(staffId)).data.email is string
            && get(/databases/$(database)/documents/payroll_staff/$(staffId)).data.email.lower() == request.auth.token.email.lower());
      allow write: if isPayrollAdmin();
    }

    // Call records. Everything about a call except its handling — the caller,
    // transcript, AI analysis, recording, Dentrix match — is written by the
    // Cloud Functions (Admin SDK, which bypasses these rules). Staff can only:
    //   - create a manual callback (QuickEntryForm.jsx → useCalls.addCall), and
    //   - change a call's queue, priority, and status (CallCard.jsx →
    //     useCalls.updateCall / resolveCall).
    // Keep the field lists in sync with those two files.
    match /artifacts/{appId}/public/data/calls/{callId} {
      function validPriority(p) {
        return p in ['NORMAL', 'TODAY', 'URGENT', 'ESCALATED'];
      }
      function validAssignment(a) {
        return a is string && a.size() > 0 && a.size() <= 100;
      }
      function changed(key) {
        return key in request.resource.data.diff(resource.data).affectedKeys();
      }

      allow read: if isApproved();

      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['fromName', 'fromNumber', 'assignment', 'priority', 'reason', 'location', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasAll(['fromName', 'fromNumber', 'assignment', 'priority', 'location', 'status', 'createdAt', 'createdBy'])
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 100
        && request.resource.data.fromNumber is string && request.resource.data.fromNumber.size() <= 20
        && validAssignment(request.resource.data.assignment)
        && validPriority(request.resource.data.priority)
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string && request.resource.data.reason.size() <= 50))
        && request.resource.data.location in ['glendale', 'litchfield']
        && request.resource.data.status == 'Waiting'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if isApproved()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['assignment', 'priority', 'status', 'updatedAt', 'resolvedAt', 'resolvedBy'])
        && (!changed('assignment') || validAssignment(request.resource.data.assignment))
        && (!changed('priority') || validPriority(request.resource.data.priority))
        && (!changed('status') || request.resource.data.status in ['Waiting', 'In Progress', 'Resolved'])
        && (!changed('updatedAt') || request.resource.data.updatedAt == request.time)
        && (!changed('resolvedAt') || request.resource.data.resolvedAt == request.time)
        && (!changed('resolvedBy') || request.resource.data.resolvedBy == request.auth.uid);

      allow delete: if isOwnerEmail();
    }

    // Appointment confirmations board. Rows are written by the
    // syncConfirmations Cloud Function (Admin SDK, bypasses rules); staff may
    // only record their own outreach on a row, never edit the Dentrix data.
    match /artifacts/{appId}/public/data/confirmations/{apptId} {
      allow read: if isApproved();
      allow update: if isApproved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outreach'])
        && request.resource.data.outreach is map;
    }
    match /confirmations_state/{office} {
      allow read: if isApproved();
    }

    // Morning huddle — built by the buildHuddle / refreshHuddle functions only.
    match /artifacts/{appId}/public/data/huddles/{huddleId} {
      allow read: if isApproved();
    }

    // Unscheduled treatment follow-up list — rows written by the
    // syncTreatmentFollowUp function; staff may only log their outreach.
    match /artifacts/{appId}/public/data/unscheduled_treatment/{rowId} {
      allow read: if isApproved();
      allow update: if isApproved()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outreach'])
        && request.resource.data.outreach is map;
    }

    // Deny everything else explicitly
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
