rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isPayrollAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.payrollRole == "admin";
    }

    // Practice owners — bootstrapped as payroll admin on first login, and
    // exempt from call deletion restrictions. Keep in sync with OWNER_EMAILS
    // in src/utils/payrollConstants.js.
    function isOwnerEmail() {
      return request.auth != null
        && request.auth.token.email in ['luckyj5521@gmail.com', 'cmarkel@gmail.com'];
    }

    // User profiles.
    // - A payroll admin can write anything on anyone's doc (incl. promoting/
    //   demoting `payrollRole`).
    // - Anyone can self-write fields OTHER than `payrollRole` (their own
    //   profile info).
    // - `payrollRole` can only be self-written once, to bootstrap it for the
    //   very first time, and only to the value this rule itself computes
    //   (admin for owner emails, viewer otherwise) — mirrors the client-side
    //   bootstrap in usePayrollRole.js, but re-validated server-side so a
    //   non-owner can never grant themselves admin, even on that first write.
    match /users/{userId} {
      allow read: if request.auth != null;

      allow write: if isPayrollAdmin()
        || (request.auth.uid == userId
            && resource != null
            && resource.data.get('payrollRole', null) == request.resource.data.get('payrollRole', null))
        || (request.auth.uid == userId
            && (resource == null || !('payrollRole' in resource.data))
            && request.resource.data.payrollRole == (isOwnerEmail() ? 'admin' : 'viewer'));
    }

    // Payroll: staff directory, schedule, and daily collections logs.
    // Read requires auth; writes require payroll admin.
    // `rate` is intentionally NOT stored here — see payroll_staffRates below —
    // so a non-admin reading the directory can never see anyone's pay rate.
    match /payroll_staff/{staffId} {
      allow read: if request.auth != null;
      allow write: if isPayrollAdmin() && !('rate' in request.resource.data);
    }
    match /payroll_schedule/{dayId} {
      allow read: if request.auth != null;
      allow write: if isPayrollAdmin();
    }
    match /payroll_dailyLogs/{dayId} {
      allow read: if request.auth != null;
      allow write: if isPayrollAdmin();
    }

    // Payroll pay rates, split out of payroll_staff so they can be locked
    // down per-person: a payroll admin can read/write any rate; a staff
    // member can only read the single rate doc whose linked payroll_staff
    // email matches their own login email (never anyone else's).
    match /payroll_staffRates/{staffId} {
      allow read: if isPayrollAdmin()
        || (request.auth != null
            && request.auth.token.email != null
            && get(/databases/$(database)/documents/payroll_staff/$(staffId)).data.email is string
            && get(/databases/$(database)/documents/payroll_staff/$(staffId)).data.email.lower() == request.auth.token.email.lower());
      allow write: if isPayrollAdmin();
    }

    // Call records — require authentication, validate writes
    match /artifacts/{appId}/public/data/calls/{callId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['fromName', 'fromNumber', 'assignment', 'priority', 'status'])
        && request.resource.data.fromName is string
        && request.resource.data.fromNumber is string
        && request.resource.data.assignment is string
        && request.resource.data.priority is string
        && request.resource.data.status is string;

      // Partial (merge) updates are expected from both staff and the mango
      // webhook function, so we don't require all fields — just type-check
      // whichever of these fields are present, to block corrupting a record.
      allow update: if request.auth != null
        && (!('fromName' in request.resource.data) || request.resource.data.fromName is string)
        && (!('fromNumber' in request.resource.data) || request.resource.data.fromNumber is string)
        && (!('assignment' in request.resource.data) || request.resource.data.assignment is string)
        && (!('priority' in request.resource.data) || request.resource.data.priority is string)
        && (!('status' in request.resource.data) || request.resource.data.status is string);

      allow delete: if isOwnerEmail();
    }

    // Deny everything else explicitly
    match /{document=**} {
      allow read, write: if false;
    }
  }
}