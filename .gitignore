# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables
.env
.env.*
.env.local
.env.production
# ...except the root .env: it's the ONLY source of VITE_FIREBASE_* build-time
# config for the GitHub Actions deploy workflow (npm run build with no other
# secrets injection) - removing it from git breaks every production build
# silently (Vite bakes in `undefined`, no build-time error) until someone's
# browser finally loads the broken bundle. These are Firebase's public
# client config values, not secrets - safe to commit.
!/.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Firebase
.firebase
firebase-debug.log
firebase-debug.*.log
